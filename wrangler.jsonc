// Cloudflare Workers Builds config: static assets from this folder, plus a Worker for /api/* (accounts, collections, recipes).
{
  "name": "painters-desk",
  "compatibility_date": "2026-10-17",
  "main": "worker/index.js",
  // Keep variables set in the Cloudflare dashboard when a build deploys (secrets are always kept).
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the paths the Worker builds itself run it first; every other file comes straight from the static files at
    // the location nearest the visitor (anything that isn't a file, like a missing page, still reaches the Worker).
    // www.paintersdesk.com -> paintersdesk.com is a Cloudflare Redirect Rule on the zone (since 2026-11-20).
    "run_worker_first": ["/api/*", "/paints", "/paints/*", "/guides", "/guides/*", "/sitemap.xml", "/.well-known/*"]
  },
  // Smart Placement runs the Worker near the D1 database (ENAM) when that is faster, so a request's several
  // database queries are short hops and only the visitor's one trip to the Worker is long. Remove to turn it off.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "painters-desk",
      "database_id": "a2a71caa-1513-48e8-a05f-9e4a40409cfb",
      "migrations_dir": "migrations"
    }
  ],
  // Tutorial photos (R2). The deploy fails if this bucket doesn't exist.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "painters-desk-images" }],
  // OAuth client IDs and secrets are set as secrets, never here (see SETUP-ACCOUNTS.md).
  // Needed by the Workers Builds preview command (npx wrangler preview) on PR branches.
  "previews": {},
  // Cloudflare Email Sending (Workers Paid) for confirmation and password-reset emails, sent from the MAIL_FROM secret.
  // paintersdesk.com must be onboarded under Email Service > Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI checks each uploaded photo before it is stored (see scanImage in worker/index.js).
  "ai": { "binding": "AI" },
  // Live chat: one ChatRoom Durable Object per room holds the open WebSocket connections (see ChatRoom in worker/index.js).
  // The deploy creates it; the migration tag below only ever grows (never edit or remove an applied one).
  "durable_objects": { "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1-chat", "new_sqlite_classes": ["ChatRoom"] }]
}
