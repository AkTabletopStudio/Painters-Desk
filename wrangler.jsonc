// Cloudflare Workers Builds config: static assets from this folder, plus a Worker for /api/* (accounts, collections, recipes).
{
  "name": "painters-desk",
  "compatibility_date": "2026-10-17",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only API requests run the Worker; every other path is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "painters-desk",
      "database_id": "a2a71caa-1513-48e8-a05f-9e4a40409cfb",
      "migrations_dir": "migrations"
    }
  ],
  // Tutorial photos (R2). The deploy fails if this bucket doesn't exist.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "painters-desk-images" }],
  // OAuth client IDs and secrets are set as secrets, never here (see SETUP-ACCOUNTS.md).
  // Needed by the Workers Builds preview command (npx wrangler preview) on PR branches.
  "previews": {}
}
