// Cloudflare Workers Builds config: static assets from this folder, plus a Worker for /api/* (accounts, collections, recipes).
{
  "name": "painters-desk",
  "compatibility_date": "2026-10-17",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only API requests run the Worker; every other path is served straight from the static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "painters-desk",
      // Replace with the ID from `npx wrangler d1 create painters-desk` before deploying. Local dev works as-is.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Tutorial photos. Create once with `npx wrangler r2 bucket create painters-desk-images`.
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "painters-desk-images" }
  ],
  // OAuth client IDs and secrets are set as secrets, never here (see SETUP-ACCOUNTS.md).
  // Needed by the Workers Builds preview command (npx wrangler preview) on PR branches.
  "previews": {}
}
